# ─────────────────────────────────────────────────────────────
#  Environment Variables Template
#  Copy this as  .env  and fill in your keys.
#  The system reads these automatically.
# ─────────────────────────────────────────────────────────────

# ─── API KEYS ─────────────────────────────────────────────
# 1. NVIDIA NIM (FREE — 1000 credits on signup)
#    Get: https://build.nvidia.com → Login → API Keys → Create
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# 2. Groq (FREE — No credit card, very fast)
#    Get: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# 3. DeepSeek (Near-free — credits on signup)
#    Get: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE

# ─── EMAIL (Optional) ─────────────────────────────────────
# Use Gmail App Password (NOT your regular Gmail password!)
# How to create App Password:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (enable if not on)
#   3. Security → App passwords → Select "Mail" → Generate
EMAIL_SENDER=your.email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_RECEIVER=recipient@gmail.com
